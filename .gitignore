# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Editors and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Generated datasets and experiment artifacts
# Everything under data/ is produced by scripts/prepare_*.py or downloaded from the
# vendor, so none of it belongs in git.  A leading pattern like data/*.parquet does NOT
# match nested directories, which is how 773MB once escaped the ignore file.
data/
outputs/
artifacts/
tmp_cache/
*.parquet
*.pkl
*.pt
*.pth
*.ckpt
# Vendor industry-classification export
*.xls
*.xlsx
# Scratch files created at the repository root only
/tmp_*.py
/tmp_*.ipynb

# Build/package artifacts
build/
dist/
*.egg-info/
.eggs/

# Local logs and runtime files
*.log
*.pid
*.lock
